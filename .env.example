DATABASE_URL=jdbc:mysql://localhost:3306/naseej
DATABASE_USERNAME=root
DATABASE_PASSWORD=

# Security
JWT_SECRET=change-me-to-a-long-random-string-of-32-chars-or-more

# Google OAuth2 (Google Cloud Console -> Credentials -> OAuth client ID)
# Authorized redirect URI: http://localhost:8080/api/v1/login/oauth2/code/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# n8n webhook that sends the OTP email via Gmail (empty = print code in console)
N8N_OTP_WEBHOOK_URL=
# n8n webhook for platform events (idea completed, contract active/expired, refund); empty = logged only
N8N_EVENTS_WEBHOOK_URL=

# First admin account, created on startup
ADMIN_EMAIL=admin@naseej.sa
ADMIN_PASSWORD=Admin12345

# Moyasar payments
MOYASAR_WEBHOOK_SECRET=
MOYASAR_PUBLISHABLE_KEY=pk_test
MOYASAR_API_KEY=sk_test
MOYASAR_CALLBACK_URL=http://localhost:8080/api/v1/payments/moyasar-callback

# Claude AI
CLAUDE_API_KEY=
CLAUDE_MODEL=claude-haiku-5-5

# Google Places
# Optional: empty = competitors come from OpenStreetMap (free, no key)
GOOGLE_PLACES_API_KEY=

# Website map tiles (optional; empty = OpenStreetMap). Restrict the key to your domain in MapTiler
MAPTILER_API_KEY=
MAPTILER_STYLE=streets-v2
